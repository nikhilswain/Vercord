{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dmap",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-28",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
}
