{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dmap",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "preview_urls": false,
  "secrets": {
    "required": [
      "DISCORD_BOT_TOKEN",
      "DISCORD_GUILD_ID",
      "MAP_SLUG",
      "SYNC_SECRET",
      "PUBLICATION_ALLOWLIST_JSON",
      "SNAPSHOT_ID_SECRET",
      "DISCORD_CLIENT_ID",
      "DISCORD_CLIENT_SECRET",
      "AUTH_SESSION_SECRET",
      "GATEWAY_BRIDGE_SECRET",
    ],
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  "kv_namespaces": [
    {
      "binding": "MAP_SNAPSHOTS",
      "id": "509e73fe886c4c638a451201158cb0f8",
      "remote": false,
    },
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "dmap-auth",
      "database_id": "41db01a3-a80a-4fe0-abb4-439a1cf2f6b4",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORLD_PRESENCE",
        "class_name": "GuildPresence",
      },
      {
        "name": "DISCORD_GATEWAY_BRIDGE",
        "class_name": "DiscordGatewayBridge",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GuildPresence"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["DiscordGatewayBridge"],
    },
  ],
}
